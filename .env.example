# ---------------------------------------------------------------------------
# DocuMind configuration. Copy this file to ".env" and edit as needed.
#   cp .env.example .env        (macOS/Linux)
#   copy .env.example .env      (Windows)
#
# Embeddings and reranking run locally for free (no key required), so retrieval
# and evaluation work out of the box. You only need a key for the LLM that
# writes the final answer -- and even that can be free (see options below).
# ---------------------------------------------------------------------------

# Which provider generates the final answer: openai | groq | ollama
LLM_PROVIDER=openai

# --- Option A: OpenAI (cheapest reliable cloud option) ---
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Option B: Groq (generous FREE tier, very fast) ---
# Get a free key at https://console.groq.com/keys  then set LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Option C: Ollama (100% free, runs locally, no key) ---
# Install from https://ollama.com , run `ollama pull llama3.1`, set LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434

# --- Retrieval / embedding settings (sensible defaults; rarely need changing) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=12
RERANK_TOP_N=4

# Where the FAISS index and processed chunks are persisted
STORAGE_DIR=storage
